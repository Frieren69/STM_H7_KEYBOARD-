	(text "USBLC6-2SC6 TVS array on D+/D- and VBUS_RAW, placed directly after\nthe connector to clamp ESD transients before they reach the rest\nof the board."
		(exclude_from_sim no)
		(at 156.21 51.816 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
			)
		)
		(uuid "3384e722-dc24-414d-9d95-320f3e498ede")
	)
	(text "PTC output feeds the buck regulator directly.\nNo load switch - removed for simplicity, since the\nbuck has its own internal soft-start."
		(exclude_from_sim no)
		(at 124.46 119.634 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "38ff8c92-fef3-49e3-a2f4-3edd298731a6")
	)
	(text "USB-C receptacle (USB 2.0, no PD). VBUS_RAW and D+/D- broken out\nto the ESD protection and PTC blocks. CC1/CC2 go to the CC\ndetection block for current-mode sensing."
		(exclude_from_sim no)
		(at 62.23 72.644 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
			)
		)
		(uuid "401e1cce-4fa0-45d7-af38-566218c7d117")
	)
	(text "USB PORT "
		(exclude_from_sim no)
		(at 45.974 17.526 0)
		(effects
			(font
				(face "Arial Black")
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "580e4c51-7208-4b72-b8c7-163281c9d717")
	)
	(text "TPS25940LRVCR eFuse, fed directly from VBUS_RAW - upstream of F1,\nso this branch is protected independently of the logic rail.\nILIM (R9 = 58.3k) sets a fixed ~1.5A current limit matching the\nType-C default current advertisement. OVP divider (R10/R15)\nprotects against overvoltage on VBUS_RAW. EN/UVLO gated by\nLED_PWR_EN (PD5) via R16 pulldown (off by default). FLT pulled up\nto 3.3V via R17 and reported to MCU as LED_PWR_FAULT_N (PD6).\nPGOOD left no-connect (unused). IMON terminated via R8 per\ndatasheet requirement, not currently routed to an MCU ADC pin."
		(exclude_from_sim no)
		(at 305.562 187.452 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "625f9e83-a298-44ac-a9e8-441a886de528")
	)
	(text "TUSB320LAIRWBR reads CC1/CC2 for Type-C current advertisement\n(default/medium/high). Reports over I2C (USB_CC_SDA/SCL on\nPB9/PB8) with USB_CC_INT_N interrupt on PB0. Firmware uses this to\nconfirm host current budget before enabling full LED brightness.\n"
		(exclude_from_sim no)
		(at 89.916 201.93 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "7b2b3aa3-61c3-45dd-9c37-1166f3886af5")
	)
	(text "3.3V Power"
		(exclude_from_sim no)
		(at 227.076 18.034 0)
		(effects
			(font
				(face "Arial Black")
				(size 1.27 1.27)
				(bold yes)
			)
		)
		(uuid "8c89d17c-fa1e-4247-a496-9a2480bc2a81")
	)
	(text "500mA hold PTC between VBUS_RAW and USB_5V_IN. Protects the logic\nbranch (U3 -> buck -> MCU) only - the LED branch has its own\nindependent protection via U6's eFuse and does not pass through F1."
		(exclude_from_sim no)
		(at 157.48 76.454 0)
		(effects
			(font
				(face "Arial Black")
				(size 0.889 0.889)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "8d41e4a9-e28d-4773-91bf-3405e5dabf4b")
	)
	(text "AP63203WU buck, fixed 3.3V output (FB tied directly to VOUT). EN\ntied to USB_5V_SW for auto-enable. Feeds STM32H723 and all 3.3V\nlogic. Independent of the LED power branch below."
		(exclude_from_sim no)
		(at 297.18 55.372 0)
		(effects
